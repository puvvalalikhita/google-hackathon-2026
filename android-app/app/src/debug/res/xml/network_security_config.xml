<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds permit LAN IP testing (e.g. 192.168.x.x FastAPI server) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
