# --- Required for Live Gemini Voice-to-Voice Mode ---
# Google AI Studio key (AIza...) or Vertex AI Express key (AQ...)
GEMINI_API_KEY=

# Optional: force Vertex AI mode ("true" | "false"); auto-detected for AQ.* keys when unset
USE_VERTEX_AI=

# Native audio Live API model (supports real-time barge-in & Hinglish/Indic speech)
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest

# Multimodal model for async WhatsApp Voice Notes & intent extraction
GEMINI_VOICE_NOTE_MODEL=gemini-2.5-flash

# Voice preset for Gemini Live API (Puck, Charon, Kore, Fenrir, Aoede)
GEMINI_VOICE_NAME=Kore

# --- Optional: Real Meta WhatsApp Cloud API Integration ---
# Leave blank to run the built-in WhatsApp Simulator & Receipt Card without Meta approval
WHATSAPP_VERIFY_TOKEN=deliverex_hackathon_verify_2026
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
MANAGER_WHATSAPP_NUMBER=

# --- Optional: Production / Go-Live Guardrails ---
ENVIRONMENT=development
ALLOW_DEMO_RESET=true
ADMIN_API_KEY=
CORS_ALLOW_ORIGINS=*
DELIVEREX_DB_PATH=
