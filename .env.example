# --- Optional: Live Gemini Voice-to-Voice Mode ---
# App starts and runs full Interactive Workflow Mode WITHOUT any key or .env file.
# Add a Google AI Studio key (AIza...) or Vertex AI Express key (AQ...) to enable Live Gemini Audio.
GEMINI_API_KEY=

# Optional: force Vertex AI mode ("true" | "false"); auto-detected for AQ.* keys when unset
USE_VERTEX_AI=

# Native audio Live API model (supports real-time barge-in & Hinglish/Telugu/Hindi/Tamil speech)
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest

# Multimodal model for async Ops Chat Voice Notes & intent extraction
GEMINI_VOICE_NOTE_MODEL=gemini-2.5-flash

# Voice preset for Gemini Live API (Puck, Charon, Kore, Fenrir, Aoede)
GEMINI_VOICE_NAME=Kore

# --- Open-Source Messaging & Push Bridge (ntfy: github.com/binwiederhier/ntfy) ---
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPIC=rajubhai-ops-353183969363
NTFY_TOKEN=

# --- Optional: Cloud Persistence (defaults to local SQLite when USE_FIRESTORE=false) ---
USE_FIRESTORE=false
FIRESTORE_PROJECT=
FIRESTORE_DATABASE=(default)
GCS_PROOF_BUCKET=

# --- Optional: Manager PIN Auth & Production Guardrails ---
ENVIRONMENT=development
ALLOW_DEMO_RESET=true
ENFORCE_MANAGER_AUTH=false
OWNER_PIN=4242
AUTH_SECRET=
CORS_ALLOW_ORIGINS=*
DELIVEREX_DB_PATH=
