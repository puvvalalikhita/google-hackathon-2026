# --- Required for Live Gemini Voice-to-Voice Mode ---
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Native audio Live API model (supports real-time barge-in & Hinglish/Indic speech)
GEMINI_LIVE_MODEL=gemini-3.8-live

# Multimodal model for async WhatsApp Voice Notes (OGG/MP3)
GEMINI_VOICE_NOTE_MODEL=gemini-3.8-flash

# Voice preset for Gemini Live API (Puck, Charon, Kore, Fenrir, Aoede)
GEMINI_VOICE_NAME=Kore

# --- Optional: Real Meta WhatsApp Cloud API Integration ---
# Leave blank to run the built-in WhatsApp Simulator & Receipt Card without Meta approval
WHATSAPP_VERIFY_TOKEN=deliverex_hackathon_verify_2026
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MANAGER_WHATSAPP_NUMBER=
